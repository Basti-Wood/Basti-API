# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored and read by docker compose + the api container.

# ---------------------------------------------------------------------------
# Basti-API
# ---------------------------------------------------------------------------
# Port the Basti-API is published on the host.
API_PORT=8000

# Comma-separated list of valid API keys. Clients must send one of these in
# the `x-api-key` header. Equivalent to the old envs/API.env file.
API_KEYS=

# YouTube Data API v3 key, used by Media_share to resolve song titles.
# Equivalent to the old envs/media.env YTAPI value.
YTAPI=

# ---------------------------------------------------------------------------
# FreeLLMAPI (the OpenAI-compatible router)
# ---------------------------------------------------------------------------
# Endpoint the api service uses to reach FreeLLMAPI inside the compose network.
FREELLMAPI_BASE_URL=http://freellmapi:3001/v1

# The unified API key from the FreeLLMAPI dashboard (Keys page header,
# looks like `freellmapi-...`). Fill this in after the first-time setup.
FREELLMAPI_API_KEY=

# Model the router should use, e.g. `auto`, `auto:fast`, `auto:smart`, or a
# specific model id such as `gemini-2.5-flash`.
FREELLMAPI_MODEL=auto

# Encryption key FreeLLMAPI uses to encrypt provider keys at rest.
# Generate once (64 hex chars) and keep it stable:
#   PowerShell:  $Bytes = New-Object Byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($Bytes); -join ($Bytes | ForEach-Object { "{0:x2}" -f $_ })
#   Bash:        openssl rand -hex 32
FREELLMAPI_ENCRYPTION_KEY=

# Host/port the FreeLLMAPI dashboard + API are published on.
# Keep 127.0.0.1 unless you need LAN access (trusted networks only).
FREELLMAPI_HOST_BIND=127.0.0.1
FREELLMAPI_PORT=3001
